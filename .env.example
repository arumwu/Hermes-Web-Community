# Public HTTPS origin, without a path or trailing slash.
HERMES_MOBILE_ORIGIN=https://hermes.example.com
# The existing username configured in your Hermes Gateway (not a new account).
HERMES_MOBILE_ADMIN=hermes
# Explicit profiles this single-owner web interface may use.
HERMES_MOBILE_PROFILES=default
# Canonical Hermes user home on the backend host. No credential directory mount required.
HERMES_MOBILE_FILE_ROOT=/home/hermes
HERMES_MOBILE_BACKEND=http://127.0.0.1:9119
